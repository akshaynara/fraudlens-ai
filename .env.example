# Option A: Google AI Studio key (fastest to set up)
GEMINI_API_KEY=your_key_here
# Option B: Vertex AI on Cloud Run (no key; uses the service account)
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=your-project
# GOOGLE_CLOUD_LOCATION=us-central1

GEMINI_MODEL=gemini-3.8-flash        # used for every step
# GEMINI_MODEL_PRO=                  # optional stronger model for extraction, skeptic and brief
